# Copy to .env; load using the shell or your local environment manager.
# No token values belong here. Put the token in the ignored file below.
AA_DISCORD_TOKEN_FILE=.secrets/discord-token
AA_GUILD_ID=
AA_DATA_DIR=.state
AA_SYNC_COMMANDS=true
AA_LOG_LEVEL=INFO

# Optional provider secret-file references; an empty path reports not_configured.
AA_LLM_KEY_FILE=
AA_SEARCH_KEY_FILE=
AA_LLM_MODEL=gpt-4.1-mini
AA_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
